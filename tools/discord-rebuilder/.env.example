DISCORD_TOKEN=replace-with-a-new-bot-token
APPLICATION_ID=replace-with-discord-application-id
GUILD_ID=replace-with-aeloria-guild-id
OPERATOR_IDS=replace-with-authorized-discord-user-id
OWNER_IDS=replace-with-owner-discord-user-id,optional-second-owner-discord-user-id
# Optional serious-alert recipients; use Discord user IDs for yourself and Salty.
ALERT_USER_IDS=your-discord-user-id,salty-discord-user-id
ADMIN_MODE=false
GOD_MODE=false
OBSIDIAN_VAULT_PATH=C:\path\to\AeloriaVault
OBSIDIAN_OPEN_COMMAND=obsidian
AUTO_INITIALIZE_VAULT=true
AUTO_OPEN_OBSIDIAN=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_STARTUP_CHECK=true
OLLAMA_AUTO_START=true
OLLAMA_COMMAND=ollama
OLLAMA_STARTUP_TIMEOUT_MS=15000
ENABLE_CONVERSATION_MODE=true
ENABLE_MENTION_CHAT=true
# Explicit allowlist for ordinary Warden conversation. The bot never listens server-wide.
CHAT_CHANNEL_IDS=
ENABLE_AMBIENT_TEXT=false
AMBIENT_CHANNEL_IDS=
AUDIT_CHANNEL_IDS=
AUDIT_MESSAGE_LIMIT=50
ENABLE_AUTO_ROLE_SEPARATORS=false
ROLE_MENU_CHANNEL_ID=
ENABLE_DASHBOARD=false
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3180
DASHBOARD_ACCESS_TOKEN=replace-with-a-long-local-dashboard-token
# Preferred for shared workshop access: email:token,email:token. Tokens stay local and are combined with Cloudflare Access identity.
DASHBOARD_ACCESS_USERS=owner@example.com:replace-with-owner-dashboard-token,salty@example.com:replace-with-salty-dashboard-token
DASHBOARD_OPERATOR_USERS=owner@example.com,salty@example.com
DASHBOARD_REQUIRE_CLOUDFLARE_IDENTITY=true
DASHBOARD_WORKSPACE_PATH=
# Persisted setup settings are stored under the workspace as setup-settings.json.
# Defaults: auto setup on ready, welcome package on, welcome channel 👋・welcome, setup conversation on.
# On a genuinely blank first-run guild, Warden temporarily binds the sole text channel automatically.
# Smoke tests are owner-triggered only; no enable flag is required.
# Emergency lockdown is owner-triggered and changes public text-channel SendMessages overwrites.
